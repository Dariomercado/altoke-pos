{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // apps/api corre sus .ts directamente con Node (type stripping): los imports relativos
    // llevan la extensión .ts y TypeScript tiene que aceptarla.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@altoke/domain": ["./packages/domain/src/index.ts"],
      "@altoke/store": ["./packages/store/src/index.ts"],
      "@altoke/contracts": ["./packages/contracts/src/index.ts"],
      "@altoke/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "vitest.config.ts"
  ]
}
